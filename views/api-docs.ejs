                    <label>数量限制:</label>
                    <input type="number" id="cinema-top" value="3" placeholder="返回数量">
                </div>
                <div class="url-preview" id="url-preview-cinema-top">/api/cinemas/top/3</div>
                <button class="test-button" onclick="testEndpoint('cinema-top')">测试接口</button>
                <button class="clear-button" onclick="clearResult('cinema-top')">清除结果</button>
                <div id="result-cinema-top" class="result"></div>
