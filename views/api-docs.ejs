                    <input type="number" id="cinema-distance" value="5" placeholder="输入距离（公里）">
                </div>
                <div class="url-preview" id="url-preview-cinema-distance">/api/cinemas/distance/5</div>
                <button class="test-button" onclick="testEndpoint('cinema-distance')">测试接口</button>
                <button class="clear-button" onclick="clearResult('cinema-distance')">清除结果</button>
                <div id="result-cinema-distance" class="result"></div>
            </div>
        </div>

        <div class="endpoint">
            <span class="method">GET</span>
            <span class="url">/api/cinemas/price/:minPrice/:maxPrice</span>
            <div class="description">根据价格范围获取影院</div>
