            <div class="test-section">
                <div class="url-preview" id="url-preview-cinema-stats">/api/cinemas/stats</div>
                <button class="test-button" onclick="testEndpoint('cinema-stats')">测试接口</button>
                <button class="clear-button" onclick="clearResult('cinema-stats')">清除结果</button>
                <div id="result-cinema-stats" class="result"></div>
            </div>
        </div>

        <div class="endpoint">
            <span class="method">GET</span>
            <span class="url">/api/cinemas/cities</span>
            <div class="description">获取所有城市列表</div>
            <div class="example">
                <strong>示例:</strong> GET /api/cinemas/cities
            </div>
            <div class="test-section">
                <div class="url-preview" id="url-preview-cinema-cities">/api/cinemas/cities</div>
