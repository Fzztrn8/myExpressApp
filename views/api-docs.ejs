    <script>
        // 更新URL预览
        function updateUrlPreview(endpointId) {
            const previewElement = document.getElementById(`url-preview-${endpointId}`);
            if (!previewElement) return;

            let url = '';
            switch (endpointId) {
                case 'cinemas':
                    url = '/api/cinemas';
                    break;
                case 'cinema-id': {
                    const cinemaId = document.getElementById('cinema-id').value || 'C001';
                    url = `/api/cinemas/${encodeURIComponent(cinemaId)}`;
                    break;
                }
                case 'cinema-city': {
                    const city = document.getElementById('cinema-city').value || '北京';
                    url = `/api/cinemas/city/${encodeURIComponent(city)}`;
                    break;
                }
                case 'cinema-distance':
                    const distance = document.getElementById('cinema-distance').value || '5';
                    url = `/api/cinemas/distance/${distance}`;
                    break;
                case 'cinema-price':
                    const minPrice = document.getElementById('cinema-min-price').value || '40';
                    const maxPrice = document.getElementById('cinema-max-price').value || '50';
                    url = `/api/cinemas/price/${minPrice}/${maxPrice}`;
                    break;
                case 'cinema-rating':
                    const rating = document.getElementById('cinema-rating').value || '8.5';
                    url = `/api/cinemas/rating/${rating}`;
                    break;
                case 'cinema-search':
                    const searchKeyword = document.getElementById('cinema-search').value || '万达';
                    url = `/api/cinemas/search/${encodeURIComponent(searchKeyword)}`;
                    break;
                case 'cinema-top':
                    const topLimit = document.getElementById('cinema-top').value || '3';
                    url = `/api/cinemas/top/${topLimit}`;
                    break;
                case 'cinema-nearest':
                    const nearestLimit = document.getElementById('cinema-nearest').value || '5';
                    url = `/api/cinemas/nearest/${nearestLimit}`;
                    break;
                case 'cinema-cheapest':
                    const cheapestLimit = document.getElementById('cinema-cheapest').value || '3';
                    url = `/api/cinemas/cheapest/${cheapestLimit}`;
                    break;
                case 'cinema-stats':
                    url = '/api/cinemas/stats';
                    break;
                case 'cinema-cities':
                    url = '/api/cinemas/cities';
                    break;
                case 'movies':
                    url = '/api/movies';
                    break;
                case 'movie-id':
                    const movieId = document.getElementById('movie-id').value || '1';
                    url = `/api/movies/${movieId}`;
                    break;
                case 'movie-type':
                    const type = document.getElementById('movie-type').value || '动作';
                    url = `/api/movies/type/${encodeURIComponent(type)}`;
                    break;
                case 'movie-director':
                    const director = document.getElementById('movie-director').value || '张艺谋';
                    url = `/api/movies/director/${encodeURIComponent(director)}`;
                    break;
                case 'movie-actor':
                    const actor = document.getElementById('movie-actor').value || '成龙';
                    url = `/api/movies/actor/${encodeURIComponent(actor)}`;
                    break;
                case 'movie-search':
                    const movieSearchTerm = document.getElementById('movie-search').value || '英雄';
                    url = `/api/movies/search/${encodeURIComponent(movieSearchTerm)}`;
                    break;
                case 'movie-top':
                    const movieTopLimit = document.getElementById('movie-top').value || '5';
                    url = `/api/movies/top/${movieTopLimit}`;
                    break;
                case 'movie-stats':
                    url = '/api/movies/stats/overview';
                    break;
                case 'user-profile':
                    url = '/users/profile';
                    break;
                case 'check-username': {
                    const val = document.getElementById('check-username').value || 'testuser';
                    url = `/users/check-username/${encodeURIComponent(val)}`;
                    break;
                }
                case 'videos':
                    url = '/videos';
                    break;
                case 'video-detail': {
                    const val = document.getElementById('video-detail-id').value || '1';
                    url = `/videos/${val}`;
                    break;
                }
                case 'video-search': {
                    const val = document.getElementById('video-search').value || '测试';
                    url = `/videos/search/${encodeURIComponent(val)}`;
                    break;
                }
                case 'video-stats':
                    url = '/videos/stats/platforms';
                    break;
            }
            previewElement.textContent = url;
        }

        // 为所有输入框添加事件监听器
        document.addEventListener('DOMContentLoaded', function() {
            const inputs = document.querySelectorAll('input');
            inputs.forEach(input => {
                input.addEventListener('input', function() {
                    // 根据输入框的ID确定对应的endpoint
                    const inputId = this.id;
                    let endpointId = '';
                    
                    if (inputId.includes('cinema-')) {
                        endpointId = inputId;
                    } else if (inputId.includes('movie-')) {
                        endpointId = inputId;
                    } else if (inputId.includes('user-') || inputId.includes('login-') || inputId.includes('check-')) {
                        endpointId = inputId;
                    } else if (inputId.includes('video-')) {
                        endpointId = inputId;
                    }
                    
                    if (endpointId) {
                        updateUrlPreview(endpointId);
                    }
                });
            });

            // 初始化所有URL预览
            const endpoints = [
                'cinemas', 'cinema-id', 'cinema-city', 'cinema-distance', 'cinema-price',
                'cinema-rating', 'cinema-search', 'cinema-top', 'cinema-nearest',
                'cinema-cheapest', 'cinema-stats', 'cinema-cities',
                'movies', 'movie-id', 'movie-type', 'movie-director', 'movie-actor',
                'movie-search', 'movie-top', 'movie-stats',
                'user-profile', 'check-username',
                'videos', 'video-detail', 'video-search', 'video-stats'
            ];
            
            endpoints.forEach(endpointId => {
                updateUrlPreview(endpointId);
            });
        });

        async function testEndpoint(endpointId) {
            const resultDiv = document.getElementById(`result-${endpointId}`);
            if (!resultDiv) return;

            resultDiv.style.display = 'block';
            resultDiv.className = 'result loading';
            resultDiv.innerHTML = '正在测试...';

            try {
                let url = '';
                switch (endpointId) {
                    case 'cinemas':
                        url = '/api/cinemas';
                        break;
                    case 'cinema-id': {
                        const cinemaId = document.getElementById('cinema-id').value || 'C001';
                        url = `/api/cinemas/${encodeURIComponent(cinemaId)}`;
                        break;
                    }
                    case 'cinema-city':
                        const city = document.getElementById('cinema-city').value || '北京';
                        url = `/api/cinemas/city/${encodeURIComponent(city)}`;
                        break;
                    case 'cinema-distance':
                        const distance = document.getElementById('cinema-distance').value || '5';
                        url = `/api/cinemas/distance/${distance}`;
                        break;
                    case 'cinema-price':
                        const minPrice = document.getElementById('cinema-min-price').value || '40';
                        const maxPrice = document.getElementById('cinema-max-price').value || '50';
                        url = `/api/cinemas/price/${minPrice}/${maxPrice}`;
                        break;
                    case 'cinema-rating':
                        const rating = document.getElementById('cinema-rating').value || '8.5';
                        url = `/api/cinemas/rating/${rating}`;
                        break;
                    case 'cinema-search':
                        const searchKeyword = document.getElementById('cinema-search').value || '万达';
                        url = `/api/cinemas/search/${encodeURIComponent(searchKeyword)}`;
                        break;
                    case 'cinema-top':
                        const topLimit = document.getElementById('cinema-top').value || '3';
                        url = `/api/cinemas/top/${topLimit}`;
                        break;
                    case 'cinema-nearest':
                        const nearestLimit = document.getElementById('cinema-nearest').value || '5';
                        url = `/api/cinemas/nearest/${nearestLimit}`;
                        break;
                    case 'cinema-cheapest':
                        const cheapestLimit = document.getElementById('cinema-cheapest').value || '3';
                        url = `/api/cinemas/cheapest/${cheapestLimit}`;
                        break;
                    case 'cinema-stats':
                        url = '/api/cinemas/stats';
                        break;
                    case 'cinema-cities':
                        url = '/api/cinemas/cities';
                        break;
                    case 'movies':
                        url = '/api/movies';
                        break;
                    case 'movie-id':
                        const movieId = document.getElementById('movie-id').value || '1';
                        url = `/api/movies/${movieId}`;
                        break;
                    case 'movie-type':
                        const type = document.getElementById('movie-type').value || '动作';
                        url = `/api/movies/type/${encodeURIComponent(type)}`;
                        break;
                    case 'movie-director':
                        const director = document.getElementById('movie-director').value || '张艺谋';
                        url = `/api/movies/director/${encodeURIComponent(director)}`;
                        break;
                    case 'movie-actor':
                        const actor = document.getElementById('movie-actor').value || '成龙';
                        url = `/api/movies/actor/${encodeURIComponent(actor)}`;
                        break;
                    case 'movie-search':
                        const movieSearchTerm = document.getElementById('movie-search').value || '英雄';
                        url = `/api/movies/search/${encodeURIComponent(movieSearchTerm)}`;
                        break;
                    case 'movie-top':
                        const movieTopLimit = document.getElementById('movie-top').value || '5';
                        url = `/api/movies/top/${movieTopLimit}`;
                        break;
                    case 'movie-stats':
                        url = '/api/movies/stats/overview';
                        break;
                    case 'check-username': {
                        const val = document.getElementById('check-username').value || 'testuser';
                        url = `/users/check-username/${encodeURIComponent(val)}`;
                        break;
                    }
                    case 'video-detail': {
                        const val = document.getElementById('video-detail-id').value || '1';
                        url = `/videos/${val}`;
                        break;
                    }
                    case 'video-search': {
                        const val = document.getElementById('video-search').value || '测试';
                        url = `/videos/search/${encodeURIComponent(val)}`;
                        break;
                    }
                }

                const response = await fetch(url);
                const data = await response.json();
                
                resultDiv.className = response.ok ? 'result success' : 'result error';
                resultDiv.innerHTML = `
                    <strong>请求URL:</strong> ${url}<br>
                    <strong>状态码:</strong> ${response.status}<br>
                    <strong>响应时间:</strong> ${new Date().toLocaleTimeString()}<br>
                    <strong>响应数据:</strong><br>
                    <pre>${JSON.stringify(data, null, 2)}</pre>
                `;
            } catch (error) {
                resultDiv.className = 'result error';
                resultDiv.innerHTML = `
                    <strong>错误:</strong><br>
                    <pre>${error.message}</pre>
                `;
            }
        }

        function clearResult(endpointId) {
            const resultDiv = document.getElementById(`result-${endpointId}`);
            if (resultDiv) {
                resultDiv.style.display = 'none';
                resultDiv.innerHTML = '';
            }
        }
    </script>
