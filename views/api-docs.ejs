            <div class="description">用户登录</div>
            <div class="example">
                <strong>示例:</strong> POST /users/login<br>
                <strong>请求体:</strong> { "username": "testuser", "password": "123456" }
            </div>
            <div class="test-section">
                <div class="input-group">
                    <label>用户名:</label>
                    <input type="text" id="login-username" value="testuser" placeholder="输入用户名">
                </div>
