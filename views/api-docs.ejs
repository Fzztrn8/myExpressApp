                <div class="input-group">
                    <label>最低评分:</label>
                    <input type="number" id="cinema-rating" value="8.5" step="0.1" placeholder="最低评分">
                </div>
                <div class="url-preview" id="url-preview-cinema-rating">/api/cinemas/rating/8.5</div>
                <button class="test-button" onclick="testEndpoint('cinema-rating')">测试接口</button>
                <button class="clear-button" onclick="clearResult('cinema-rating')">清除结果</button>
                <div id="result-cinema-rating" class="result"></div>
