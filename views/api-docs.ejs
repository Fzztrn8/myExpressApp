            <div class="test-section">
                <div class="input-group">
                    <label>影院ID:</label>
                    <input type="text" id="cinema-id" value="C001" placeholder="输入影院ID">
                </div>
                <div class="url-preview" id="url-preview-cinema-id">/api/cinemas/C001</div>
                <button class="test-button" onclick="testEndpoint('cinema-id')">测试接口</button>
                <button class="clear-button" onclick="clearResult('cinema-id')">清除结果</button>
                <div id="result-cinema-id" class="result"></div>
            </div>
        </div>

        <div class="endpoint">
            <span class="method">GET</span>
            <span class="url">/api/cinemas/city/:city</span>
            <div class="description">根据城市获取影院</div>
