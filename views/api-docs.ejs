                <div class="url-preview" id="url-preview-cinema-cheapest">/api/cinemas/cheapest/3</div>
                <button class="test-button" onclick="testEndpoint('cinema-cheapest')">测试接口</button>
                <button class="clear-button" onclick="clearResult('cinema-cheapest')">清除结果</button>
                <div id="result-cinema-cheapest" class="result"></div>
