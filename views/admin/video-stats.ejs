<%- include('../partials/header') %>

<div class="container mt-4">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-chart-bar"></i> 视频统计</h2>
        <div>
          <button type="button" class="btn btn-primary" onclick="refreshStats()">
            <i class="fas fa-sync"></i> 刷新统计
          </button>
          <a href="/admin/videos" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> 返回视频列表
          </a>
        </div>
      </div>

      <div class="row">
        <div class="col-md-3">
          <div class="card text-center mb-4">
            <div class="card-body">
              <i class="fas fa-video fa-2x text-primary mb-2"></i>
              <h4 class="card-title"><%= stats.totalVideos || 0 %></h4>
              <p class="card-text">总视频数</p>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card text-center mb-4">
            <div class="card-body">
              <i class="fas fa-eye fa-2x text-success mb-2"></i>
              <h4 class="card-title"><%= stats.totalViews || 0 %></h4>
              <p class="card-text">总观看次数</p>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card text-center mb-4">
            <div class="card-body">
              <i class="fas fa-heart fa-2x text-danger mb-2"></i>
              <h4 class="card-title"><%= stats.totalLikes || 0 %></h4>
              <p class="card-text">总点赞数</p>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card text-center mb-4">
            <div class="card-body">
              <i class="fas fa-comments fa-2x text-info mb-2"></i>
              <h4 class="card-title"><%= stats.totalComments || 0 %></h4>
              <p class="card-text">总评论数</p>
            </div>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="card mb-4">
            <div class="card-header">
              <h5 class="mb-0"><i class="fas fa-fire"></i> 热门视频</h5>
            </div>
            <div class="card-body">
              <div class="list-group list-group-flush">
                <% if (popularVideos && popularVideos.length > 0) { %>
                  <% popularVideos.forEach(function(video, index) { %>
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                      <div>
                        <h6 class="mb-1"><%= video.title %></h6>
                        <small class="text-muted">
                          <i class="fas fa-eye"></i> <%= video.view_count || 0 %> 次观看
                          <i class="fas fa-heart ms-2"></i> <%= video.like_count || 0 %> 个点赞
                        </small>
                      </div>
                      <span class="badge bg-primary rounded-pill">#<%= index + 1 %></span>
                    </div>
                  <% }); %>
                <% } else { %>
                  <div class="text-center py-3">
                    <i class="fas fa-chart-line fa-2x text-muted mb-2"></i>
                    <p class="text-muted">暂无热门视频数据</p>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="card mb-4">
            <div class="card-header">
              <h5 class="mb-0"><i class="fas fa-clock"></i> 最新视频</h5>
            </div>
            <div class="card-body">
              <div class="list-group list-group-flush">
                <% if (latestVideos && latestVideos.length > 0) { %>
                  <% latestVideos.forEach(function(video) { %>
                    <div class="list-group-item">
                      <div class="d-flex justify-content-between align-items-center">
                        <div>
                          <h6 class="mb-1"><%= video.title %></h6>
                          <small class="text-muted">
                            <%= new Date(video.created_at).toLocaleString('zh-CN') %>
                          </small>
                        </div>
                        <div class="text-end">
                          <small class="text-muted">
                            <i class="fas fa-eye"></i> <%= video.view_count || 0 %>
                          </small>
                        </div>
                      </div>
                    </div>
                  <% }); %>
                <% } else { %>
                  <div class="text-center py-3">
                    <i class="fas fa-clock fa-2x text-muted mb-2"></i>
                    <p class="text-muted">暂无最新视频数据</p>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-8">
          <div class="card mb-4">
            <div class="card-header">
              <h5 class="mb-0"><i class="fas fa-chart-line"></i> 观看趋势</h5>
            </div>
            <div class="card-body">
              <canvas id="viewsChart" width="400" height="200"></canvas>
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="card mb-4">
            <div class="card-header">
              <h5 class="mb-0"><i class="fas fa-pie-chart"></i> 视频格式分布</h5>
            </div>
            <div class="card-body">
              <canvas id="formatChart" width="200" height="200"></canvas>
            </div>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="card mb-4">
            <div class="card-header">
              <h5 class="mb-0"><i class="fas fa-users"></i> 用户活跃度</h5>
            </div>
            <div class="card-body">
              <div class="row text-center">
                <div class="col-6">
                  <h4 class="text-primary"><%= stats.activeUsers || 0 %></h4>
                  <p class="text-muted">活跃用户</p>
                </div>
                <div class="col-6">
                  <h4 class="text-success"><%= stats.avgViewDuration || 0 %></h4>
                  <p class="text-muted">平均观看时长(秒)</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="card mb-4">
            <div class="card-header">
              <h5 class="mb-0"><i class="fas fa-database"></i> 存储统计</h5>
            </div>
            <div class="card-body">
              <div class="row text-center">
                <div class="col-6">
                  <h4 class="text-info"><%= formatFileSize(stats.totalStorage || 0) %></h4>
                  <p class="text-muted">总存储空间</p>
                </div>
                <div class="col-6">
                  <h4 class="text-warning"><%= stats.avgFileSize || 0 %></h4>
                  <p class="text-muted">平均文件大小</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
// 文件大小格式化函数
function formatFileSize(bytes) {
  if (!bytes) return '0 B';
  const k = 1024;
  const sizes = ['B', 'KB', 'MB', 'GB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}

// 观看趋势图表
const viewsCtx = document.getElementById('viewsChart').getContext('2d');
const viewsChart = new Chart(viewsCtx, {
  type: 'line',
  data: {
    labels: <%= JSON.stringify(chartData?.labels || []) %>,
    datasets: [{
      label: '观看次数',
      data: <%= JSON.stringify(chartData?.views || []) %>,
      borderColor: 'rgb(75, 192, 192)',
      backgroundColor: 'rgba(75, 192, 192, 0.2)',
      tension: 0.1
    }]
  },
  options: {
    responsive: true,
    scales: {
      y: {
        beginAtZero: true
      }
    }
  }
});

// 视频格式分布图表
const formatCtx = document.getElementById('formatChart').getContext('2d');
const formatChart = new Chart(formatCtx, {
  type: 'doughnut',
  data: {
    labels: <%= JSON.stringify(formatData?.labels || []) %>,
    datasets: [{
      data: <%= JSON.stringify(formatData?.values || []) %>,
      backgroundColor: [
        '#FF6384',
        '#36A2EB',
        '#FFCE56',
        '#4BC0C0',
        '#9966FF',
        '#FF9F40'
      ]
    }]
  },
  options: {
    responsive: true,
    plugins: {
      legend: {
        position: 'bottom'
      }
    }
  }
});

// 刷新统计数据
async function refreshStats() {
  try {
    const button = event.target;
    const originalText = button.innerHTML;
    
    button.disabled = true;
    button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> 刷新中...';
    
    // 这里可以添加刷新统计数据的API调用
    // const response = await fetch('/admin/video-stats/refresh');
    // const result = await response.json();
    
    // 模拟刷新延迟
    setTimeout(() => {
      location.reload();
    }, 1000);
    
  } catch (error) {
    console.error('刷新统计数据失败:', error);
    alert('刷新失败: ' + error.message);
  } finally {
    button.disabled = false;
    button.innerHTML = originalText;
  }
}

// 页面加载完成后的初始化
document.addEventListener('DOMContentLoaded', function() {
  console.log('视频统计页面加载完成');
});
</script>

<%- include('../partials/footer') %> 