<%- include('../partials/header') %>

<div class="container mt-4">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-table"></i> 表结构 - <%= tableName %></h2>
        <div>
          <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addColumnModal">
            <i class="fas fa-plus"></i> 添加列
          </button>
          <a href="/admin/db" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> 返回表列表
          </a>
        </div>
      </div>

      <% if (message) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <div class="card">
        <div class="card-header">
          <h5 class="mb-0"><i class="fas fa-columns"></i> 表列信息</h5>
        </div>
        <div class="card-body">
          <% if (schema && schema.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead class="table-light">
                  <tr>
                    <th>列名</th>
                    <th>数据类型</th>
                    <th>允许NULL</th>
                    <th>默认值</th>
                    <th>操作</th>
                  </tr>
                </thead>
                <tbody>
                  <% schema.forEach(function(column) { %>
                    <tr>
                      <td>
                        <strong><%= column.column_name %></strong>
                      </td>
                      <td>
                        <code><%= column.data_type %></code>
                        <% if (column.max_length) { %>
                          <small class="text-muted">(<%= column.max_length %>)</small>
                        <% } %>
                      </td>
                      <td>
                        <% if (column.is_nullable === 'YES') { %>
                          <span class="badge bg-success">是</span>
                        <% } else { %>
                          <span class="badge bg-danger">否</span>
                        <% } %>
                      </td>
                      <td>
                        <% if (column.column_default) { %>
                          <code><%= column.column_default %></code>
                        <% } else { %>
                          <span class="text-muted">无</span>
                        <% } %>
                      </td>
                      <td>
                        <button type="button" 
                                class="btn btn-sm btn-outline-danger"
                                onclick="confirmDropColumn('<%= column.column_name %>')">
                          <i class="fas fa-trash"></i> 删除
                        </button>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="text-center py-4">
              <i class="fas fa-columns fa-3x text-muted mb-3"></i>
              <p class="text-muted">此表暂无列定义</p>
              <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addColumnModal">
                <i class="fas fa-plus"></i> 添加第一列
              </button>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 添加列模态框 -->
<div class="modal fade" id="addColumnModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">添加新列到表 <%= tableName %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/admin/db/add-column">
        <div class="modal-body">
          <input type="hidden" name="tableName" value="<%= tableName %>">
          
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <label for="columnName" class="form-label">列名 <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="columnName" name="columnName" required>
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label for="dataType" class="form-label">数据类型 <span class="text-danger">*</span></label>
                <select class="form-select" id="dataType" name="dataType" required>
                  <option value="">请选择数据类型</option>
                  <% dataTypes.forEach(function(type) { %>
                    <option value="<%= type.value %>"><%= type.label %></option>
                  <% }); %>
                </select>
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <label for="maxLength" class="form-label">最大长度</label>
                <input type="number" class="form-control" id="maxLength" name="maxLength" 
                       placeholder="仅适用于字符串类型">
                <div class="form-text">仅对 varchar, nvarchar, char, nchar 类型有效</div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label for="isNullable" class="form-label">允许NULL</label>
                <select class="form-select" id="isNullable" name="isNullable">
                  <option value="YES">是</option>
                  <option value="NO">否</option>
                </select>
              </div>
            </div>
          </div>

          <div class="mb-3">
            <label for="defaultValue" class="form-label">默认值</label>
            <input type="text" class="form-control" id="defaultValue" name="defaultValue" 
                   placeholder="可选，如: 0, '默认文本', GETDATE()">
            <div class="form-text">可以是常量值或SQL函数，如 GETDATE(), NEWID() 等</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-plus"></i> 添加列
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- 删除列确认模态框 -->
<div class="modal fade" id="dropColumnModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">确认删除列</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p>您确定要删除列 <strong id="columnNameToDrop"></strong> 吗？</p>
        <p class="text-danger">
          <i class="fas fa-exclamation-triangle"></i> 
          此操作不可逆，列中的所有数据将被永久删除！
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
        <form method="POST" action="/admin/db/drop-column" style="display: inline;">
          <input type="hidden" name="tableName" value="<%= tableName %>">
          <input type="hidden" name="columnName" id="columnNameInput">
          <button type="submit" class="btn btn-danger">
            <i class="fas fa-trash"></i> 确认删除
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
function confirmDropColumn(columnName) {
  document.getElementById('columnNameToDrop').textContent = columnName;
  document.getElementById('columnNameInput').value = columnName;
  new bootstrap.Modal(document.getElementById('dropColumnModal')).show();
}

// 根据数据类型显示/隐藏最大长度字段
document.getElementById('dataType').addEventListener('change', function() {
  const dataType = this.value.toLowerCase();
  const maxLengthField = document.getElementById('maxLength');
  const maxLengthRow = maxLengthField.closest('.col-md-6');
  
  if (dataType.includes('varchar') || dataType.includes('char')) {
    maxLengthRow.style.display = 'block';
  } else {
    maxLengthRow.style.display = 'none';
    maxLengthField.value = '';
  }
});
</script>

<%- include('../partials/footer') %> 