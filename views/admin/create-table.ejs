<%- include('../partials/header') %>

<div class="container mt-4">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-plus-circle"></i> 创建新表</h2>
        <a href="/admin/db" class="btn btn-secondary">
          <i class="fas fa-arrow-left"></i> 返回表列表
        </a>
      </div>

      <% if (message) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <div class="card">
        <div class="card-header">
          <h5 class="mb-0"><i class="fas fa-table"></i> 表信息</h5>
        </div>
        <div class="card-body">
          <form method="POST" action="/admin/db/create-table" id="createTableForm">
            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="tableName" class="form-label">表名 <span class="text-danger">*</span></label>
                  <input type="text" class="form-control" id="tableName" name="tableName" required>
                  <div class="form-text">使用有意义的表名，如: users, products, orders</div>
                </div>
              </div>
            </div>

            <hr>

            <div class="d-flex justify-content-between align-items-center mb-3">
              <h6><i class="fas fa-columns"></i> 表列定义</h6>
              <button type="button" class="btn btn-sm btn-primary" onclick="addColumn()">
                <i class="fas fa-plus"></i> 添加列
              </button>
            </div>

            <div id="columnsContainer">
              <!-- 列定义将在这里动态添加 -->
            </div>

            <div class="alert alert-info">
              <i class="fas fa-info-circle"></i>
              <strong>提示：</strong>
              <ul class="mb-0 mt-2">
                <li>每个表至少需要一个列</li>
                <li>建议为每个表定义一个主键列（通常是 id）</li>
                <li>字符串类型（varchar, nvarchar）需要指定最大长度</li>
                <li>可以使用 SQL 函数作为默认值，如 GETDATE(), NEWID()</li>
              </ul>
            </div>

            <div class="mt-4">
              <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> 创建表
              </button>
              <a href="/admin/db" class="btn btn-secondary">
                <i class="fas fa-times"></i> 取消
              </a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 列定义模板 -->
<template id="columnTemplate">
  <div class="column-row border rounded p-3 mb-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h6 class="mb-0">列 #<span class="column-number"></span></h6>
      <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeColumn(this)">
        <i class="fas fa-trash"></i> 删除
      </button>
    </div>
    
    <div class="row">
      <div class="col-md-6">
        <div class="mb-3">
          <label class="form-label">列名 <span class="text-danger">*</span></label>
          <input type="text" class="form-control column-name" name="columns[].name" required>
        </div>
      </div>
      <div class="col-md-6">
        <div class="mb-3">
          <label class="form-label">数据类型 <span class="text-danger">*</span></label>
          <select class="form-select column-type" name="columns[].type" required>
            <option value="">请选择数据类型</option>
            <% dataTypes.forEach(function(type) { %>
              <option value="<%= type.value %>"><%= type.label %></option>
            <% }); %>
          </select>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-3">
        <div class="mb-3">
          <label class="form-label">最大长度</label>
          <input type="number" class="form-control column-length" name="columns[].maxLength" 
                 placeholder="字符串类型">
        </div>
      </div>
      <div class="col-md-3">
        <div class="mb-3">
          <label class="form-label">允许NULL</label>
          <select class="form-select column-nullable" name="columns[].isNullable">
            <option value="YES">是</option>
            <option value="NO">否</option>
          </select>
        </div>
      </div>
      <div class="col-md-3">
        <div class="mb-3">
          <label class="form-label">默认值</label>
          <input type="text" class="form-control column-default" name="columns[].defaultValue" 
                 placeholder="可选">
        </div>
      </div>
      <div class="col-md-3">
        <div class="mb-3">
          <label class="form-label">主键</label>
          <div class="form-check">
            <input class="form-check-input column-primary" type="checkbox" name="columns[].isPrimaryKey">
            <label class="form-check-label">设为主键</label>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
let columnCounter = 0;

function addColumn() {
  columnCounter++;
  const template = document.getElementById('columnTemplate');
  const clone = template.content.cloneNode(true);
  
  // 更新列号
  clone.querySelector('.column-number').textContent = columnCounter;
  
  // 更新name属性
  const inputs = clone.querySelectorAll('[name^="columns[]"]');
  inputs.forEach(input => {
    input.name = input.name.replace('[]', `[${columnCounter - 1}]`);
  });
  
  // 添加事件监听器
  const typeSelect = clone.querySelector('.column-type');
  typeSelect.addEventListener('change', function() {
    toggleLengthField(this);
  });
  
  document.getElementById('columnsContainer').appendChild(clone);
}

function removeColumn(button) {
  button.closest('.column-row').remove();
  updateColumnNumbers();
}

function updateColumnNumbers() {
  const rows = document.querySelectorAll('.column-row');
  rows.forEach((row, index) => {
    row.querySelector('.column-number').textContent = index + 1;
  });
}

function toggleLengthField(select) {
  const dataType = select.value.toLowerCase();
  const lengthField = select.closest('.column-row').querySelector('.column-length');
  const lengthCol = lengthField.closest('.col-md-3');
  
  if (dataType.includes('varchar') || dataType.includes('char')) {
    lengthCol.style.display = 'block';
  } else {
    lengthCol.style.display = 'none';
    lengthField.value = '';
  }
}

// 表单验证
document.getElementById('createTableForm').addEventListener('submit', function(e) {
  const columns = document.querySelectorAll('.column-row');
  if (columns.length === 0) {
    e.preventDefault();
    alert('请至少添加一个列');
    return;
  }
  
  // 检查是否有主键
  const primaryKeys = document.querySelectorAll('.column-primary:checked');
  if (primaryKeys.length === 0) {
    if (!confirm('没有设置主键，确定要继续吗？')) {
      e.preventDefault();
      return;
    }
  }
  
  // 验证列名唯一性
  const columnNames = Array.from(document.querySelectorAll('.column-name')).map(input => input.value);
  const uniqueNames = new Set(columnNames);
  if (uniqueNames.size !== columnNames.length) {
    e.preventDefault();
    alert('列名必须唯一');
    return;
  }
});

// 页面加载时添加第一个列
document.addEventListener('DOMContentLoaded', function() {
  addColumn();
});
</script>

<%- include('../partials/footer') %> 